{
  "name": "sungero-remote-component-react-starter",
  "version": "1.0.0",
  "description": "Starter template for developing Sungero Remote Components with React for DirectumRX.",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:write": "biome check . --write",
    "serve:dist": "serve dist -p 3000",
    "generate:component-metadata": "node scripts/generate-component-metadata.js",
    "watch:component-metadata": "node scripts/watch-component-metadata.js",
    "prepare:host-assets": "node scripts/prepare-host-assets.js",
    "build:remote": "webpack --config config/webpack/webpack.remote.js --mode production --progress=profile",
    "build:remote:dev": "webpack --config config/webpack/webpack.remote.js --mode development --progress=profile",
    "build:standalone:dev": "npm run prepare:host-assets && npm run generate:component-metadata && concurrently \"npm run watch:component-metadata\" \"webpack --config config/webpack/webpack.standalone.js --mode development --progress=profile\"",
    "start:standalone:dev": "npm run prepare:host-assets && npm run generate:component-metadata && concurrently \"npm run watch:component-metadata\" \"webpack serve --config config/webpack/webpack.standalone.js --mode development --progress=profile\"",
    "watch:remote": "webpack --config config/webpack/webpack.remote.js --mode development --watch --progress=profile",
    "start:remote:dev": "concurrently \"npm:watch:remote\" \"npm:serve:dist\""
  },
  "keywords": [],
  "author": "Denis Nikolaev",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@types/quill": "2.0.14",
    "gantt-task-react": "0.3.8",
    "i18next": "23.11.5",
    "react": "17.0.2",
    "react-data-grid": "^7.0.0-beta.16",
    "react-dom": "17.0.2",
    "react-i18next": "14.1.3",
    "react-quill-new": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.4.9",
    "@directum/sungero-remote-component-metadata-plugin": "^1.0.1",
    "@directum/sungero-remote-component-types": "^1.0.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^30.0.0",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "babel-loader": "^10.1.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.4.2",
    "html-webpack-plugin": "^5.6.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1"
  }
}
